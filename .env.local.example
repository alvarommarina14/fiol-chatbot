# Copy to .env.local and fill in the values from Meta for Developers.
# .env.local is gitignored: never commit it.

# WhatsApp > API Setup > Temporary access token (expires after 24 hours)
WHATSAPP_ACCESS_TOKEN=

# WhatsApp > API Setup > Phone number ID (the long numeric id, NOT the phone number)
WHATSAPP_PHONE_NUMBER_ID=

# App settings > Basic > App secret ("Show" button)
WHATSAPP_APP_SECRET=

# Your own choice. Must match exactly the token entered in Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=fiol-webhook-2026
