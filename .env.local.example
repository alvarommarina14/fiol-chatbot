# Copy to .env.local and fill in the values from Meta for Developers.
# .env.local is gitignored: never commit it.

# WhatsApp > API Setup > Temporary access token (expires after 24 hours)
WHATSAPP_ACCESS_TOKEN=

# WhatsApp > API Setup > Phone number ID (the long numeric id, NOT the phone number)
WHATSAPP_PHONE_NUMBER_ID=

# App settings > Basic > App secret ("Show" button)
WHATSAPP_APP_SECRET=

# Your own choice. Must match exactly the token entered in Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=fiol-webhook-2026

# Set to true when testing with a development phone number and an Argentine mobile.
# WhatsApp reports the sender as 549XXXXXXXXXX, but the test recipient allow list only
# stores the form without the 9, so replies fail with error 131030. Leave false in
# production: there is no allow list there and the unmodified wa_id is the right recipient.
WHATSAPP_STRIP_AR_MOBILE_NINE=false
